calcular_nuevas_opciones <- function(opcion_g, opcion_1){
if(opcion_g == opcion_1){
x <- sample((1:nPuertas)[1:nPuertas != opcion_g], 1)
return(c(x,opcion_1))
}else{
return(c(opcion_g, opcion_1))
}
}
cambiar <- replicate(1000, {
opcion_ganadora =  sample(1:nPuertas, 1)
primera_eleccion = sample(1:nPuertas, 1)
# Trabajo del presentador...
nuevas_opciones <- calcular_nuevas_opciones(opcion_ganadora, primera_eleccion)
segunda_eleccion <- nuevas_opciones[nuevas_opciones != primera_eleccion]
segunda_eleccion == opcion_ganadora
})
mean(no_cambiar)
mean(cambiar)
